[Unit]
Description=nvpoca virtual camera (GPU background effects)
Documentation=file://%h/Development/mk-nvpoca/README.md

[Service]
# Type=dbus: systemd counts the service as up once it owns its bus name (device ready)
Type=dbus
BusName=org.nvpoca.Daemon
ExecStart=%h/Development/mk-nvpoca/build/nvpoca
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
